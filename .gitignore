# macOS and Google Drive leftovers
.DS_Store
.tmp.drive*
*.download

# Python
__pycache__/
*.pyc

# The scraper's working files: the .pmtiles as downloaded and their zoom-12
# dumps (hundreds of MB, re-fetchable), and the reference geographies the
# projection fit needs, which are built from Census sources rather than kept.
build/scraper/raw/
build/scraper/out/
build/scraper/counties.json
build/scraper/ak_house.json

# Jekyll's own output and cache. .jekyll-cache is caught by the global
# gitignore on this machine, which a clone elsewhere will not have, and _site
# is ~115 MB of built copy that nobody should commit.
_site/
.jekyll-cache/
